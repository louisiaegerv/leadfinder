# Bring your own keys. Copy to .env.local.
APIFY_TOKEN=
# Apify actor used for Google Maps scraping (username/name or actor id)
APIFY_MAPS_ACTOR_ID=scraperlink/google-maps-scraper
# Apify plan decides the per-result rate: free | starter | scale | business
APIFY_PLAN=starter

# Apify actor that finds owner names and emails from a business website (~$0.015 per business)
APIFY_ENRICH_ACTOR_ID=menus-r-us/business-profile-enricher

# Apify actor that googles for the owner (~$0.0005 per search); a model then reads the snippets
APIFY_SEARCH_ACTOR_ID=scraperlink/google-search-results-serp-scraper

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
