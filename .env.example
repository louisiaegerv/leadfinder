# Bring your own keys. Copy to .env.local.
APIFY_TOKEN=
# Apify actor used for Google Maps scraping (username/name or actor id)
APIFY_MAPS_ACTOR_ID=scraperlink/google-maps-scraper
# Apify plan decides the per-result rate: free | starter | scale | business
APIFY_PLAN=starter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
